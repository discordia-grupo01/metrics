ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Envio de logs a New Relic (opcional). Sin URL no se envia nada.
# La clave sale de OTEL_EXPORTER_OTLP_HEADERS salvo que se defina LOG_SHIP_API_KEY.
# LOG_SHIP_URL=https://log-api.newrelic.com/log/v1
# LOG_SHIP_API_KEY=

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSLMODE=disable
# Optional. If set, it takes precedence over the DATABASE_* variables.
DATABASE_URL=

JWT_SECRET=
RABBITMQ_URL=
EVENTS_EXCHANGE=discordia.events
EVENTS_QUEUE=metrics
STAFF_USER_IDS=
ADMIN_EVENTS_HMAC_SECRET=
# Comma-separated list of service=URL pairs. Production values are in README.
HEALTH_CHECKS=
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=3s
HEALTH_FAILURE_THRESHOLD=2
HEALTH_RECOVERY_THRESHOLD=2
