ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Envio de logs a New Relic (opcional). Sin URL no se envia nada.
# La clave sale de OTEL_EXPORTER_OTLP_HEADERS salvo que se defina LOG_SHIP_API_KEY.
# LOG_SHIP_URL=https://log-api.newrelic.com/log/v1
# LOG_SHIP_API_KEY=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=discordia_metrics
DATABASE_USER=discordia
DATABASE_PASSWORD=discordia
DATABASE_SSLMODE=disable
# Optional. If set, it takes precedence over the DATABASE_* variables.
DATABASE_URL=

# Solo para desarrollo local: con este header se puede probar sin JWT. Nunca en
# un entorno desplegado.
USER_ID_HEADER=X-User-Id

# Vacio = la API arranca pero no consume eventos (las metricas quedan en cero).
# Para probarlos, levantar RabbitMQ con el repo rabbit-mq y completar:
#   RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_URL=

# Lo mismo, pero para cuando el servicio corre en el docker compose de este
# repo: desde un contenedor, localhost es el propio contenedor.
#   RABBITMQ_URL_DOCKER=amqp://guest:guest@host.docker.internal:5672/
RABBITMQ_URL_DOCKER=
EVENTS_EXCHANGE=discordia.events
EVENTS_QUEUE=metrics
# Usuario de prueba con permisos de staff.
STAFF_USER_IDS=11111111-1111-4111-8111-111111111111
ADMIN_EVENTS_HMAC_SECRET=secreto-admin-solo-local
# Comma-separated list of service=public gateway URL pairs. Do not point these
# at private service IPs; use the gateway host/domain and /health/... routes.
HEALTH_CHECKS=identify=https://tu-dominio/health/identify,servers=https://tu-dominio/health/servers,messaging=https://tu-dominio/health/messaging,notifications=https://tu-dominio/health/notifications,voice=https://tu-dominio/health/voice
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=3s
HEALTH_FAILURE_THRESHOLD=2
HEALTH_RECOVERY_THRESHOLD=2
